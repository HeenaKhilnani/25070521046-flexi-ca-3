# NEXTEST Environment Configuration

# Server Port (default 5001)
PORT=5001

# Node Environment
NODE_ENV=development

# MongoDB Connection String (MongoDB Compass or local mongod or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/nextest
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nextest?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nextest

# Database Name
DB_NAME=nextest

# Session Secret for cookie signing / verification
SESSION_SECRET=nextest_super_secure_session_secret_change_in_production_key_32bytes

# CORS Allowed Origin (Vite client URL)
CORS_ORIGIN=http://localhost:5173
